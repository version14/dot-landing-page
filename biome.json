{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.dot",
      "!**/.next",
      "!**/coverage",
      "!**/dist",
      "!**/playwright-report",
      "!**/storybook-static",
      "!src/routeTree.gen.ts",
      "!**/styled-system"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
